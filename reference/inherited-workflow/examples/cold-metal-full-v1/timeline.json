  "captions": [
    {
      "start": 0.18,
      "end": 1.53,
      "lines": [
        "These two spoons can be"
      ]
    },
    {
      "start": 1.53,
      "end": 3.23,
      "lines": [
        "exactly the same temperature."
      ]
    },
    {
      "start": 3.48,
      "end": 5.14,
      "lines": [
        "But metal feels colder."
      ]
    },
    {
      "start": 5.52,
      "end": 6.01,
      "lines": [
        "How?"
      ]
    },
    {
      "start": 6.269999999999999,
      "end": 7.509999999999999,
      "lines": [
        "Leave metal and wood"
      ]
    },
    {
      "start": 7.509999999999999,
      "end": 8.79,
      "lines": [
        "in the same room long enough,"
      ]
    },
    {
      "start": 8.87,
      "end": 10.76,
      "lines": [
        "and both settle",
        "to room temperature."
      ]
    },
    {
      "start": 11.293333333333333,
      "end": 13.783333333333333,
      "lines": [
        "Your hand is warmer",
        "than the spoon."
      ]
    },
    {
      "start": 14.263333333333334,
      "end": 17.183333333333334,
      "lines": [
        "Touch it, and heat flows",
        "out of your skin."
      ]
    },
    {
      "start": 17.53333333333333,
      "end": 20.483333333333334,
      "lines": [
        "Metal carries that energy",
        "away faster than wood."
      ]
    },
    {
      "start": 21.053333333333335,
      "end": 22.513333333333335,
      "lines": [
        "Same starting temperature."
      ]
    },
    {
      "start": 22.71333333333333,
      "end": 24.303333333333335,
      "lines": [
        "Different heat transfer."
      ]
    },
    {
      "start": 24.383333333333333,
      "end": 26.183333333333334,
      "lines": [
        "That colder feeling comes from"
      ]
    },
    {
      "start": 26.183333333333334,
      "end": 27.78333333333333,
      "lines": [
        "your skin cooling faster."
      ]
    },
    {
      "start": 28.073333333333334,
      "end": 30.433333333333334,
      "lines": [
        "Wood takes heat away",
        "more slowly."
      ]
    },
    {
      "start": 30.693333333333335,
      "end": 31.943333333333335,
      "lines": [
        "Your hand isn't simply reading"
      ]
    },
    {
      "start": 31.943333333333335,
      "end": 33.39333333333333,
      "lines": [
        "the spoon's temperature."
      ]
    },
    {
      "start": 33.653333333333336,
      "end": 35.22333333333333,
      "lines": [
        "It's responding to heat"
      ]
    },
    {
      "start": 35.22333333333333,
      "end": 36.47333333333333,
      "lines": [
        "leaving your skin."
      ]
    }
  ],
